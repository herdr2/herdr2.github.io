---
import config from 'virtual:starlight/user-config';
import LanguageSelect from '@astrojs/starlight/components/LanguageSelect.astro';
import Search from 'starlight-theme-black/overrides/Search.astro';
import SocialIcons from 'starlight-theme-black/overrides/SocialIcons.astro';
import ThemeSelect from 'starlight-theme-black/overrides/ThemeSelect.astro';
import SiteTitle from 'starlight-theme-black/overrides/SiteTitle.astro';
import { resolveLocale, resolveNavLinks } from '../lib/i18nNav';

const shouldRenderSearch =
  config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';

const currentPath = Astro.url.pathname;
const locale = resolveLocale(Astro.locals.starlightRoute?.locale, currentPath);
const navItems = resolveNavLinks(locale);
const homeHref = locale === 'en' ? '/en/' : '/';
---

<div class="header-left">
  <button class="show-modal" popovertargetaction="toggle" popovertarget="drawer">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 9h16.5m-16.5 6.75h16.5"></path>
    </svg>
    <span class="sr-only">{locale === 'en' ? 'Toggle Menu' : '打开导航菜单'}</span>
  </button>

  <a class="mobile-brand" href={homeHref} aria-label="Herdr2">
    <img src="/favicon.svg" alt="" width="22" height="22" />
    <span>Herdr2</span>
  </a>

  <div class="site-title-wrapper">
    <SiteTitle />
    <nav class="nav-bar">
      {
        navItems.map((nav) => (
          <a class:list={[{ active: currentPath === nav.href }]} href={nav.href} {...nav.attrs}>
            {nav.label}
          </a>
        ))
      }
    </nav>
  </div>
</div>

<div class="header-right">
  {shouldRenderSearch && <div class="header-search"><Search /></div>}

  <nav class="header-nav">
    <div class="header-social">
      <SocialIcons />
    </div>
    <div>
      <ThemeSelect />
    </div>
    <div class="header-lang">
      <LanguageSelect />
    </div>
  </nav>
</div>

<style>
  .header-left {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    flex-shrink: 0;
  }

  .mobile-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    text-decoration: none;
    color: var(--h2-text);
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: -0.02em;
    margin-right: 0.4rem;
  }

  .mobile-brand img {
    border-radius: 5px;
    display: block;
  }

  .site-title-wrapper {
    display: none;
    align-items: center;
    margin-right: 1rem;
  }

  @media (min-width: 768px) {
    .mobile-brand {
      display: none;
    }
    .site-title-wrapper {
      display: flex;
    }
  }

  .nav-bar {
    font-size: 0.855rem;
    line-height: 1.25rem;
    gap: 0.25rem;
    align-items: center;
    display: flex;
    margin-left: 1rem;
  }

  @media (min-width: 1280px) {
    .nav-bar {
      gap: 0.35rem;
    }
  }

  .nav-bar a {
    text-decoration: none;
    padding: 0.35rem 0.65rem;
    border-radius: 7px;
    font-weight: 500;
    transition: color 140ms ease, background-color 140ms ease;
    color: var(--h2-text-muted);
    white-space: nowrap;
  }

  .nav-bar a:hover {
    color: var(--h2-text);
    background: var(--h2-surface-muted);
  }

  .nav-bar a.active {
    color: var(--h2-text);
    background: var(--h2-surface-muted);
    font-weight: 600;
  }

  .header-right {
    gap: 0.4rem;
    justify-content: flex-end;
    align-items: center;
    flex: 1 1 0%;
    min-width: 0;
    display: flex;
  }

  .header-search {
    flex: 1 1 0%;
    min-width: 0;
    max-width: 11rem;
  }

  @media (min-width: 768px) {
    .header-search {
      flex: none;
      max-width: none;
    }
  }

  .header-nav {
    gap: 0.15rem;
    align-items: center;
    display: flex;
    flex-shrink: 0;
  }

  .header-social {
    display: none;
  }

  @media (min-width: 520px) {
    .header-social {
      display: block;
    }
  }

  @media (max-width: 640px) {
    .header-lang :global(label) {
      --sl-select-width: 5.2em !important;
      font-size: 0.78rem;
    }
    .header-search :global(button[data-open-modal]) {
      padding-inline: 0.65rem;
      font-size: 0.8rem;
    }
  }

  .show-modal {
    all: unset;
    display: inline-flex;
    margin-left: -0.35rem;
    height: 2.25rem;
    width: 2.25rem;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    cursor: pointer;
    color: var(--h2-text);
  }

  @media (min-width: 768px) {
    .show-modal {
      display: none;
    }
  }

  .show-modal > svg {
    width: 1.35rem;
    height: 1.35rem;
  }
</style>
