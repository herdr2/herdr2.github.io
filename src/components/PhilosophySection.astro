---
const pillars = [
  {
    badge: 'HARNESS OF HARNESSES · ADE',
    title: '面向多 Agent 时代的新一代 ADE',
    desc: 'Claude Code、Codex、Antigravity、Cursor、Gemini、OpenCode 本身各是一套 Agent Harness；Herdr2 是凌驾其上的「Harness of Harnesses」，将 14 种异构编程智能体与真终端统一收编到同一个 Agentic Development Environment（ADE）中协同作战。',
    tags: ['14 种内置 Harness', '跨模型 Handoff / Fork', '统一权限与 MCP'],
  },
  {
    badge: 'ALWAYS-ON DAEMON',
    title: 'Agent 后台常驻，工作永不掉线',
    desc: '桌面客户端与核心运行时彻底解耦，所有交互式真终端（t*）与无头 ACP 智能体（a*）全部持久化托管在 h2 守护进程中。关闭窗口、热升级界面、合上笔记本甚至断开 SSH，Agent 军团照常编码、跑测与推进，重连秒回现场。',
    tags: ['关窗不断流', 'SSH 断线续跑', '零中断热更 UI'],
  },
  {
    badge: 'DROVE ORCHESTRATION',
    title: 'Drove 原生多 Agent DAG 编排',
    desc: '内置单守护进程多智能体编排引擎，按角色隔离权限（writable / scoped_write / readonly + OS 沙盒）与独立 Git Worktree，自动执行 Verify 验收门禁、多候选模型故障顺延与异构交叉 Code Review，并提供实时 Web DAG 监控台。',
    tags: ['有向无环图调度', '异构交叉审查', '自动验收与自愈'],
  },
  {
    badge: 'BUILT-IN CORE AI',
    title: '自带全局轻量 Core AI 能力',
    desc: '不仅调度外部 Coding Agent，Herdr2 自身内置全局共享的轻量 Core AI 控制面（兼容 DeepSeek / OpenAI / Ollama 等接口），贯穿日常高频环节：提示词一键润色、Git Diff 自动生成提交说明、终端状态仲裁、离线进展 Catch-up 摘要、智能接力推荐与自然语言快照故障反查。',
    tags: ['提示词润色 & AI 提交', '子 Agent 进展摘要', '自然语言 Bisect'],
  },
];
---

<section class="h2-section" id="philosophy">
  <div class="h2-container">
    <div class="story-card">
      <div class="story-header">
        <span class="h2-eyebrow">命名哲学 · 为什么叫 Herdr2 与 Drove？</span>
        <h2 class="story-title">
          从「单兵手写代码」到「牧羊人放牧多 Agent 牧群」
        </h2>
        <p class="story-lead">
          在 AI 辅助软件工程时代，开发者的核心工作不再是独自埋头敲下每一行代码，而是统筹、引导并验收一支并行推进的智能体工程小队——这正是
          <strong>Herdr</strong> 与 <strong>Drove</strong> 名字背后的具象写照。
        </p>
      </div>

      <div class="metaphor-grid">
        <div class="metaphor-item">
          <div class="metaphor-head">
            <span class="metaphor-word">Herdr</span>
            <span class="metaphor-cn">牧羊人 · 统筹者</span>
          </div>
          <p>
            <strong>你是牧羊人，Herdr2 是你手中的指挥台（ADE）。</strong>
            站在全局视角分配目标、把控敏感写入审批、随时跨模型交接上下文（Handoff）与审阅纯净
            Diff，在更高的抽象层掌控工程方向与质量底线。
          </p>
        </div>

        <div class="metaphor-arrow" aria-hidden="true">→</div>

        <div class="metaphor-item metaphor-item--drove">
          <div class="metaphor-head">
            <span class="metaphor-word">Drove</span>
            <span class="metaphor-cn">被驱赶前行的牧群</span>
          </div>
          <p>
            <strong>Drove 是有序协作前行的多 Agent 牧群。</strong>
            编码、测试、文档、调研与异构审查等不同角色的智能体在 DAG 依赖与沙盒护栏下结群并行推进，遇到失败自动顺延重试，持续向交付终点稳步前进。
          </p>
        </div>
      </div>
    </div>

    <div class="pillar-grid">
      {
        pillars.map((p, idx) => (
          <article class="h2-card pillar-card">
            <div class="pillar-top">
              <span class="pillar-num">0{idx + 1}</span>
              <span class="pillar-badge">{p.badge}</span>
            </div>
            <h3>{p.title}</h3>
            <p>{p.desc}</p>
            <div class="pillar-tags">
              {p.tags.map((t) => (
                <span>{t}</span>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .story-card {
    border-radius: 18px;
    border: 1px solid var(--h2-border-strong);
    background: linear-gradient(
      180deg,
      var(--h2-surface-subtle) 0%,
      var(--h2-surface) 100%
    );
    padding: clamp(1.5rem, 3vw, 2.5rem);
    margin-bottom: 1.75rem;
  }

  .story-header {
    max-width: 780px;
    margin: 0 auto 2rem;
    text-align: center;
  }

  .story-title {
    margin: 0.9rem 0 0.7rem;
    font-size: clamp(1.55rem, 3vw, 2.2rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.25;
    color: var(--h2-text);
    text-wrap: balance;
  }

  .story-lead {
    margin: 0;
    font-size: 0.98rem;
    color: var(--h2-text-muted);
    line-height: 1.75;
  }

  .metaphor-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    gap: 1.15rem;
    align-items: stretch;
  }

  .metaphor-item {
    border-radius: 14px;
    border: 1px solid var(--h2-border);
    background: var(--h2-surface);
    padding: 1.4rem 1.5rem;
  }

  .metaphor-item--drove {
    border-color: var(--h2-accent-border);
    background: color-mix(in srgb, var(--h2-accent-soft) 45%, var(--h2-surface));
  }

  .metaphor-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.65rem;
    margin-bottom: 0.65rem;
  }

  .metaphor-word {
    font-family: var(--sl-font-mono);
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--h2-accent);
    letter-spacing: -0.02em;
  }

  .metaphor-cn {
    font-size: 0.84rem;
    font-weight: 600;
    padding: 0.16rem 0.6rem;
    border-radius: 999px;
    background: var(--h2-surface-subtle);
    border: 1px solid var(--h2-border);
    color: var(--h2-text);
  }

  .metaphor-item p {
    margin: 0;
    font-size: 0.92rem;
    color: var(--h2-text-muted);
    line-height: 1.72;
  }

  .metaphor-item strong {
    color: var(--h2-text);
  }

  .metaphor-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--h2-accent);
    padding-inline: 0.2rem;
  }

  .pillar-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .pillar-card {
    display: flex;
    flex-direction: column;
    padding: 1.55rem;
  }

  .pillar-top {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.75rem;
  }

  .pillar-num {
    font-family: var(--sl-font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--h2-accent);
    padding: 0.14rem 0.45rem;
    border-radius: 6px;
    background: var(--h2-accent-soft);
  }

  .pillar-badge {
    font-family: var(--sl-font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--h2-text-subtle);
  }

  .pillar-card h3 {
    margin: 0 0 0.6rem;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--h2-text);
  }

  .pillar-card p {
    margin: 0 0 1.1rem;
    font-size: 0.92rem;
    color: var(--h2-text-muted);
    line-height: 1.72;
    flex: 1;
  }

  .pillar-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .pillar-tags span {
    font-size: 0.76rem;
    padding: 0.2rem 0.6rem;
    border-radius: 6px;
    background: var(--h2-surface-subtle);
    border: 1px solid var(--h2-border);
    color: var(--h2-text-subtle);
  }

  @media (max-width: 820px) {
    .metaphor-grid {
      grid-template-columns: 1fr;
    }
    .metaphor-arrow {
      transform: rotate(90deg);
      padding-block: 0.15rem;
    }
    .pillar-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
