---
import { getFooterHtml, resolveLocale, resolveNavLinks } from '../lib/i18nNav';

const { hasSidebar, siteTitleHref, sidebar, locale: routeLocale } = Astro.locals.starlightRoute;
const locale = resolveLocale(routeLocale, Astro.url.pathname);
const navItems = resolveNavLinks(locale);
const footerHtml = getFooterHtml(locale);
const homeLabel = locale === 'en' ? 'Home' : '首页';
---

<div class="layout">
  <div class="layout__grid">
    <header class="layout__header">
      <div class="container-wrapper">
        <div class="container container__header">
          <slot name="header" />
        </div>
      </div>
    </header>
    <main class="main">
      {!hasSidebar && <slot />}

      {
        hasSidebar && (
          <div class="container-wrapper">
            <div class="container container-wrapper-main">
              <aside class="aside">
                <slot name="sidebar" />
              </aside>

              <slot />
            </div>
          </div>
        )
      }
    </main>
    <footer class="footer">
      <div class="container-wrapper">
        <div class="container footer-container">
          <div class="footer-text" set:html={footerHtml} />
        </div>
      </div>
    </footer>
  </div>

  <div popover="auto" id="drawer">
    <button class="sheet-overlay" popovertarget="drawer" popovertargetaction="hide"></button>
    <div class="content">
      <div class="header">
        <button class="drag-icon" popovertarget="drawer" popovertargetaction="hide"><span></span></button>
      </div>
      <div class="body">
        <div class="links-nav">
          <a href={siteTitleHref}>{homeLabel}</a>
          {
            navItems.map((nav) => (
              <a href={nav.href} {...nav.attrs}>
                {nav.label}
              </a>
            ))
          }
        </div>

        <div class="links-docs">
          {
            sidebar.map(
              (entry) =>
                entry.type !== 'link' && (
                  <div class="container-sidebar-entry">
                    <h4 class="entry-title">{entry.label}</h4>

                    {entry.entries.map(
                      (link) =>
                        link.type === 'link' && (
                          <a href={link.href} {...link.attrs}>
                            {link.label}
                          </a>
                        ),
                    )}
                  </div>
                ),
            )
          }
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .layout {
    background-color: var(--background);
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    position: relative;
  }

  .layout__grid {
    border-color: color-mix(in oklab, var(--border) 30%, transparent);
    display: flex;
    flex-direction: column;
    flex: 1 1 0%;
  }

  :global([data-theme='dark']) .layout__grid {
    border-color: var(--border);
  }

  .layout__header {
    background-color: color-mix(in oklab, var(--background) 60%, transparent);
    border-color: color-mix(in oklab, var(--border) 30%, transparent);
    border-bottom-width: 1px;
    border-bottom-style: solid;
    width: 100%;
    z-index: 50;
    top: 0;
    position: sticky;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  :global([data-theme='dark']) .layout__header {
    border-color: var(--border);
  }

  .container__header {
    display: flex;
    align-items: center;
    height: 3.5rem;
  }

  .main {
    display: flex;
    flex: 1 1 0%;
    flex-direction: column;
  }

  .container-wrapper-main {
    align-items: flex-start;
    flex: 1 1 0%;
  }

  @media (min-width: 1024px) {
    .container-wrapper-main {
      gap: 2.5rem;
      grid-template-columns: 240px minmax(0, 1fr);
    }
  }

  @media (min-width: 768px) {
    .container-wrapper-main {
      gap: 1.5rem;
      grid-template-columns: 220px minmax(0, 1fr);
      display: grid;
    }
  }

  .aside {
    border-color: color-mix(in oklab, var(--border) 30%, transparent);
    border-right-width: 1px;
    border-right-style: solid;
    flex-shrink: 0;
    width: 100%;
    height: calc(100vh - 3.5rem);
    display: none;
    z-index: 30;
    top: 3.5rem;
    position: fixed;
  }

  :global([data-theme='dark']) .aside {
    border-color: var(--border);
  }

  @media (min-width: 768px) {
    .aside {
      display: block;
      position: sticky;
    }
  }

  .footer {
    border-color: color-mix(in oklab, var(--border) 30%, transparent);
    padding-top: 1.5rem;
    padding-bottom: 1.5rem;
    border-top-width: 1px;
    border-top-style: solid;
  }

  :global([data-theme='dark']) .footer {
    border-color: var(--border);
  }
  @media (min-width: 768px) {
    .footer {
      padding-top: 0;
      padding-bottom: 0;
      padding-left: 2rem;
      padding-right: 2rem;
    }
  }

  .footer-container {
    margin-left: auto;
    margin-right: auto;
    max-width: 1536px;
    padding-left: 1rem;
    padding-right: 1rem;
    padding-top: 1rem;
    padding-bottom: 1rem;
  }

  @media (min-width: 1280px) {
    .footer-container {
      padding-left: 1.5rem;
      padding-right: 1.5rem;
    }
  }

  .footer-text {
    color: var(--muted-foreground);
    font-size: 0.875rem;
    line-height: 1.25rem;
    text-align: center;
    text-wrap: balance;
  }

  @media (min-width: 768px) {
    .footer-text {
      text-align: left;
    }
  }

  #drawer button {
    all: unset;
  }

  [popover] {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    display: flex;
    opacity: 0;
    pointer-events: none;
    align-items: center;
    flex-direction: column;
    justify-content: flex-end;
    transition: 0.1s linear;
    z-index: 1000;
    background: transparent;
    border: none;
  }

  [popover]::backdrop {
    background: rgba(0, 0, 0, 0.8);
  }

  [popover]:popover-open {
    opacity: 1;
    pointer-events: auto;
  }

  [popover]:popover-open .content {
    transform: translateY(0%);
  }

  .sheet-overlay {
    position: fixed;
    top: 0;
    left: 0;
    z-index: -1;
    width: 100vw;
    height: 100vh;
    opacity: 0.1;
    background-color: transparent;
  }

  .content {
    width: 100%;
    position: relative;
    background: var(--background);
    max-height: 100vh;
    height: 50vh;
    max-width: 1150px;
    transform: translateY(100%);
    border-radius: 12px 12px 0 0;
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.03);
    transition: 0.3s ease;
  }

  .header {
    display: flex;
    justify-content: center;
  }

  .header .drag-icon span {
    height: 0.1rem;
    width: 100px;
    display: block;
    background-color: var(--muted);
    border-radius: 9999px;
    margin-top: 1rem;
  }

  .body {
    height: 100%;
    overflow-y: auto;
    padding: 1.5rem;
  }

  .body::-webkit-scrollbar {
    width: 0;
  }

  .links-nav {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .links-nav a {
    font-size: 1rem;
    line-height: 1.5rem;
    color: inherit;
    text-decoration: inherit;
  }

  .links-docs {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .container-sidebar-entry {
    padding-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .entry-title {
    font-weight: 500;
  }

  .container-sidebar-entry a {
    font-size: 1rem;
    line-height: 1.5rem;
    color: var(--muted-foreground);
    text-decoration: inherit;
  }
</style>

<style is:global>
  .footer-text a {
    text-underline-offset: 4px;
    text-decoration-line: underline;
    font-weight: 500;
    color: inherit;
  }
</style>
