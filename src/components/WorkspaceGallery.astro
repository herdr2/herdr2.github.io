---
const shots = [
  {
    tag: '终端 + 源码同屏',
    title: '真终端与内置代码浏览器联动',
    desc: '左侧 Ghostty 真终端跑命令、看 Git 状态，右侧直接打开语法高亮代码文件与目录树，支持编辑、批注与复制。',
    img: '/images/docs/05-files-panel.png',
    alt: 'Herdr2 终端与内置文件代码浏览面板实拍',
    docHref: '/guide/02-workspaces-and-terminals/',
  },
  {
    tag: 'Git Diff + AI 提交',
    title: '实时变更审查与一键 AI 生成提交信息',
    desc: '不离开工作区即可逐文件审查实时 Diff（支持直接/分栏切换），并直接点击「AI 生成」提炼规范 Commit Message。',
    img: '/images/docs/06-changes-panel.png',
    alt: 'Herdr2 实时 Git 变更 Diff 与 AI 提交面板实拍',
    docHref: '/guide/02-workspaces-and-terminals/',
  },
  {
    tag: '无污染轮次快照',
    title: '隐藏 Git Ref 快照回滚与自然语言故障定位',
    desc: '按回合记录 T0 / T1 / T2 工作区状态且不污染正常 Git 分支，随时查看单轮纯净 Diff、一键恢复或反查故障引入轮次。',
    img: '/images/docs/07-checkpoints-panel.png',
    alt: 'Herdr2 隐藏 Git Ref 逐轮快照与故障定位面板实拍',
    docHref: '/guide/04-handoff-checkpoints-and-ai/',
  },
  {
    tag: '无头 ACP + 安全护栏',
    title: '结构化智能体对话与行内权限审批',
    desc: '左栏实时置顶「待确认」红标告警，右侧在对话流内清晰展示待修改文件与 Allow once / Reject 审批按钮，杜绝失控写入。',
    img: '/images/docs/10-acp-permission-blocked.png',
    alt: 'Herdr2 无头 ACP 智能体行内权限审批实拍',
    docHref: '/guide/03-headless-acp-agents/',
  },
  {
    tag: '跨模型无缝交棒',
    title: '上下文接力（Handoff）与隔离会话分叉',
    desc: '一键将最近 4 / 8 / 15 轮进展与代码改动提炼交棒给 Claude Code、Codex、Antigravity、OpenCode 等任意目标 Agent。',
    img: '/images/docs/09-handoff-dialog.png',
    alt: 'Herdr2 跨智能体上下文接力与分叉弹窗实拍',
    docHref: '/guide/04-handoff-checkpoints-and-ai/',
  },
  {
    tag: 'Drove 多智能体军团',
    title: '实时 DAG 编排画布与异构审查监控',
    desc: '内置只读 Web 监控台（127.0.0.1:7799），全局追踪多角色 Worker 派发、任务拓扑依赖、校验门禁与审查员连线。',
    img: '/images/docs/15-drove-web-dag.png',
    alt: 'Herdr2 Drove Web 多智能体 DAG 实时编排画布实拍',
    docHref: '/guide/05-drove-orchestration/',
  },
];
---

<section class="h2-section" id="screenshots">
  <div class="h2-container">
    <div class="h2-section-header h2-section-header--center">
      <span class="h2-section-kicker">In Production · Live Captures</span>
      <h2 class="h2-section-title">看看 Herdr2 在日常开发中的真实画面</h2>
      <p class="h2-section-desc">
        以下全部为 Herdr2 桌面端（GPUI）与 Drove Web 在实际代码仓中的真实运行截图——点击任意截图均可全屏放大查看细节。
      </p>
    </div>

    <div class="wg-grid">
      {
        shots.map((s) => (
          <figure class="wg-card">
            <div class="wg-frame">
              <div class="wg-frame-bar">
                <div class="h2-window-dots" aria-hidden="true">
                  <span></span><span></span><span></span>
                </div>
                <span class="wg-tag">{s.tag}</span>
                <span class="wg-zoom-hint">点击放大</span>
              </div>
              <img
                src={s.img}
                alt={s.alt}
                class="wg-img h2-zoomable"
                loading="eager"
                decoding="async"
              />
            </div>
            <figcaption class="wg-caption">
              <div class="wg-caption-head">
                <h3>{s.title}</h3>
                <a href={s.docHref}>查看手册 →</a>
              </div>
              <p>{s.desc}</p>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .wg-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .wg-card {
    margin: 0;
    display: flex;
    flex-direction: column;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid var(--h2-border);
    background: var(--h2-surface);
    transition: border-color 180ms ease, transform 180ms ease, box-shadow 180ms ease;
  }

  .wg-card:hover {
    border-color: var(--h2-accent-border);
    transform: translateY(-2px);
    box-shadow: var(--h2-shadow-lg);
  }

  .wg-frame {
    border-bottom: 1px solid var(--h2-border);
    background: var(--h2-surface-subtle);
  }

  .wg-frame-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.55rem 0.9rem;
    border-bottom: 1px solid var(--h2-border);
    font-size: 0.75rem;
    color: var(--h2-text-subtle);
  }

  .wg-tag {
    font-family: var(--sl-font-mono);
    font-weight: 600;
    color: var(--h2-accent);
  }

  .wg-zoom-hint {
    font-size: 0.72rem;
    opacity: 0.8;
  }

  .wg-img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top left;
    background: var(--h2-diagram-bg);
    cursor: zoom-in;
  }

  .wg-caption {
    padding: 1.15rem 1.25rem 1.3rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    flex: 1;
  }

  .wg-caption-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .wg-caption h3 {
    margin: 0;
    font-size: 1.04rem;
    font-weight: 700;
    color: var(--h2-text);
    line-height: 1.35;
  }

  .wg-caption a {
    flex-shrink: 0;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--h2-accent);
    text-decoration: none;
  }

  .wg-caption a:hover {
    text-decoration: underline;
  }

  .wg-caption p {
    margin: 0;
    font-size: 0.88rem;
    color: var(--h2-text-muted);
    line-height: 1.65;
  }

  @media (max-width: 820px) {
    .wg-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
